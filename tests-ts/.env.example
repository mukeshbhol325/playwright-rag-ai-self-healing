BASE_URL=https://demo.opencart.com
HEALER_URL=http://localhost:8000

# Healing
HEALING_ENABLED=true
HEAL_ACTION_TIMEOUT_MS=5000
HEALER_TIMEOUT_MS=15000
MIN_CONFIDENCE=0.6
MAX_CANDIDATES=3
# Reuse locators healed in earlier runs instead of healing again
USE_HEALED_CACHE=false
# Fail the run if more than this many locators were healed (-1 = no limit)
MAX_HEALS=-1

# Demo: deliberately break locators to show healing against the live site
SIMULATE_DRIFT=false

LOG_LEVEL=info

# Optional: run with a custom Chromium binary instead of Playwright's download
# CHROMIUM_PATH=
# CHROMIUM_ARGS=
# on | off | retain-on-failure (default)
# VIDEO_MODE=retain-on-failure
