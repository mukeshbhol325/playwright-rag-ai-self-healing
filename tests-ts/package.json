{
  "name": "selfheal-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript UI tests with RAG-based self-healing locators",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test --grep @e2e",
    "test:healing": "playwright test --grep @healing",
    "test:offline": "playwright test --grep @offline",
    "test:saucedemo": "playwright test tests/saucedemo",
    "test:drift": "cross-env SIMULATE_DRIFT=true playwright test --grep \"@e2e\"",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report reports/html",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}