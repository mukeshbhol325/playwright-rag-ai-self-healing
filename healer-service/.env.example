# none      = heuristic + memory only (no API key needed; good for demos and CI)
# anthropic = LLM re-ranks candidates using retrieved past cases
# openai    = same, with OpenAI
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# hashing = offline embeddings (default) | openai = real embeddings
EMBEDDINGS_PROVIDER=hashing

KB_DIR=./data/chroma
LOG_LEVEL=INFO
MAX_DOM_CHARS=200000
